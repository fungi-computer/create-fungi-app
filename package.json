{
  "name": "create-fungi-app",
  "version": "0.0.109",
  "description": "Create a TypeScript App with a local Oyster, then build a Release to install on your Oyster.",
  "homepage": "https://docs.fungi.computer/create-fungi-app",
  "keywords": [
    "fungi",
    "typescript",
    "app-starter",
    "scaffolding",
    "oyster",
    "local-development"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0"
  },
  "bin": {
    "create-fungi-app": "dist/cli.js",
    "fungi-app": "dist/app-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/cli.js --help",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@fungi.computer/lantern": "0.4.2",
    "zod": "4.4.3",
    "@fungi.computer/oyster": "0.46.3",
    "@fungi.computer/puffball": "0.12.0",
    "effect": "4.0.2",
    "validate-npm-package-name": "7.0.2",
    "@fungi.computer/cairn": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "tsx": "4.23.12",
    "playwright": "1.62.1",
    "@types/validate-npm-package-name": "4.0.2"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/create-fungi-app.git"
  }
}
